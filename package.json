{
  "name": "dsh-sidebar-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open any DeepSeek Harness Session in a floating dock beside the work you are doing: read it, reply to it, and keep the Session you are in running.",
  "license": "MIT",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "sidebar",
    "floating",
    "popup",
    "chat"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "LICENSE",
    "README.md",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "index.js",
    "package.json",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "check": "node --check client.js",
    "test": "node tests/regression.mjs"
  }
}
